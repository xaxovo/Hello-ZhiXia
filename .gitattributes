# 默认：文本文件在仓库中统一使用 LF，检出时按平台自动转换
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary

# 语言统计
*.md text
*.json text
*.yml text
*.yaml text
